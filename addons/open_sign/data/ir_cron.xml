<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_open_sign_send_reminders" model="ir.cron">
        <field name="name">Open Sign: Send Reminders</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="open_sign.model_open_sign_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
    </record>

    <record id="ir_cron_open_sign_expire_requests" model="ir.cron">
        <field name="name">Open Sign: Expire Requests</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="open_sign.model_open_sign_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_requests()</field>
    </record>
</odoo>
