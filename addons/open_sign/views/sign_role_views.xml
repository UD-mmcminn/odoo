<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_open_sign_role_list" model="ir.ui.view">
            <field name="name">open.sign.role.view.list</field>
            <field name="model">open.sign.role</field>
            <field name="arch" type="xml">
                <list string="Signer Roles" sample="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="required"/>
                    <field name="template_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_open_sign_role_search" model="ir.ui.view">
            <field name="name">open.sign.role.view.search</field>
            <field name="model">open.sign.role</field>
            <field name="arch" type="xml">
                <search string="Signer Roles">
                    <field name="name"/>
                    <field name="template_id"/>
                    <filter name="filter_required" string="Required" domain="[('required', '=', True)]"/>
                    <group>
                        <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_open_sign_role_form" model="ir.ui.view">
            <field name="name">open.sign.role.view.form</field>
            <field name="model">open.sign.role</field>
            <field name="arch" type="xml">
                <form string="Signer Role">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="template_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="required"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_open_sign_template_form_roles" model="ir.ui.view">
            <field name="name">open.sign.template.view.form.roles</field>
            <field name="model">open.sign.template</field>
            <field name="inherit_id" ref="open_sign.view_open_sign_template_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group" position="after">
                    <notebook>
                        <page string="Signer Roles" name="signer_roles">
                            <field name="role_ids">
                                <list editable="bottom" default_order="sequence asc">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="color" optional="hide"/>
                                </list>
                                <form string="Signer Role">
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group>
                                            <field name="required"/>
                                            <field name="color" widget="color_picker"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>

        <record id="action_open_sign_role" model="ir.actions.act_window">
            <field name="name">Signer Roles</field>
            <field name="res_model">open.sign.role</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="open_sign.view_open_sign_role_search"/>
        </record>
    </data>
</odoo>
