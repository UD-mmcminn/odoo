<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_open_sign_template_field_list" model="ir.ui.view">
            <field name="name">open.sign.template.field.view.list</field>
            <field name="model">open.sign.template.field</field>
            <field name="arch" type="xml">
                <list string="Template Fields" sample="1">
                    <field name="sequence" widget="handle"/>
                    <field name="label"/>
                    <field name="type"/>
                    <field name="role_id"/>
                    <field name="page"/>
                    <field name="required"/>
                    <field name="template_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_open_sign_template_field_search" model="ir.ui.view">
            <field name="name">open.sign.template.field.view.search</field>
            <field name="model">open.sign.template.field</field>
            <field name="arch" type="xml">
                <search string="Template Fields">
                    <field name="label"/>
                    <field name="type"/>
                    <field name="role_id"/>
                    <field name="template_id"/>
                    <filter name="filter_required" string="Required" domain="[('required', '=', True)]"/>
                    <group>
                        <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                        <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                        <filter name="group_role" string="Role" context="{'group_by': 'role_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_open_sign_template_field_form" model="ir.ui.view">
            <field name="name">open.sign.template.field.view.form</field>
            <field name="model">open.sign.template.field</field>
            <field name="arch" type="xml">
                <form string="Template Field">
                    <sheet>
                        <group>
                            <group>
                                <field name="label"/>
                                <field name="type"/>
                                <field name="template_id"/>
                                <field name="role_id" domain="[('template_id', '=', template_id)]"/>
                                <field name="required"/>
                            </group>
                            <group>
                                <field name="page"/>
                                <field name="sequence"/>
                                <field name="x"/>
                                <field name="y"/>
                                <field name="width"/>
                                <field name="height"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="default_value"/>
                            </group>
                            <group>
                                <field name="validation_regex"/>
                                <field name="min_length"/>
                                <field name="max_length"/>
                            </group>
                        </group>
                        <group invisible="type not in ('radio', 'selection')">
                            <field name="option_ids">
                                <list editable="bottom" default_order="sequence asc">
                                    <field name="sequence" widget="handle"/>
                                    <field name="value"/>
                                    <field name="label"/>
                                    <field name="is_default"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_open_sign_template_form_fields" model="ir.ui.view">
            <field name="name">open.sign.template.view.form.fields</field>
            <field name="model">open.sign.template</field>
            <field name="inherit_id" ref="open_sign.view_open_sign_template_form_roles"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='signer_roles']" position="after">
                    <page string="Fields">
                        <field name="field_ids">
                            <list editable="bottom" default_order="page asc, sequence asc">
                                <field name="sequence" widget="handle"/>
                                <field name="label"/>
                                <field name="type"/>
                                <field name="role_id" domain="[('template_id', '=', parent.id)]"/>
                                <field name="page"/>
                                <field name="required"/>
                            </list>
                            <form string="Template Field">
                                <group>
                                    <group>
                                        <field name="label"/>
                                        <field name="type"/>
                                        <field name="role_id" domain="[('template_id', '=', parent.id)]"/>
                                        <field name="required"/>
                                    </group>
                                    <group>
                                        <field name="page"/>
                                        <field name="sequence"/>
                                        <field name="x"/>
                                        <field name="y"/>
                                        <field name="width"/>
                                        <field name="height"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="default_value"/>
                                    </group>
                                    <group>
                                        <field name="validation_regex"/>
                                        <field name="min_length"/>
                                        <field name="max_length"/>
                                    </group>
                                </group>
                                <group invisible="type not in ('radio', 'selection')">
                                    <field name="option_ids">
                                        <list editable="bottom" default_order="sequence asc">
                                            <field name="sequence" widget="handle"/>
                                            <field name="value"/>
                                            <field name="label"/>
                                            <field name="is_default"/>
                                        </list>
                                    </field>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="action_open_sign_template_field" model="ir.actions.act_window">
            <field name="name">Template Fields</field>
            <field name="res_model">open.sign.template.field</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="open_sign.view_open_sign_template_field_search"/>
        </record>
    </data>
</odoo>
