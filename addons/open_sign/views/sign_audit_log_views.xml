<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_open_sign_audit_log_list" model="ir.ui.view">
            <field name="name">open.sign.audit.log.view.list</field>
            <field name="model">open.sign.audit.log</field>
            <field name="arch" type="xml">
                <list string="Audit Logs" sample="1" create="0" delete="0" edit="0">
                    <field name="request_id"/>
                    <field name="event_sequence"/>
                    <field name="event_type" widget="badge"/>
                    <field name="event_at"/>
                    <field name="signer_id" optional="hide"/>
                    <field name="ip" optional="hide"/>
                    <field name="consent_text_hash" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_open_sign_audit_log_kanban" model="ir.ui.view">
            <field name="name">open.sign.audit.log.view.kanban</field>
            <field name="model">open.sign.audit.log</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1" default_group_by="event_type">
                    <field name="request_id"/>
                    <field name="event_sequence"/>
                    <field name="event_type"/>
                    <field name="event_at"/>
                    <field name="signer_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex align-items-baseline mb-2">
                                <span class="fw-bolder fs-5">#<field name="event_sequence"/></span>
                                <field name="event_type" widget="badge" class="ms-auto"/>
                            </div>
                            <div class="text-muted d-flex flex-wrap gap-1">
                                <field name="request_id"/>
                            </div>
                            <footer class="d-flex flex-wrap gap-1 text-muted mt-2">
                                <field name="event_at"/>
                                <field name="signer_id"/>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_open_sign_audit_log_search" model="ir.ui.view">
            <field name="name">open.sign.audit.log.view.search</field>
            <field name="model">open.sign.audit.log</field>
            <field name="arch" type="xml">
                <search string="Audit Logs">
                    <field name="request_id"/>
                    <field name="event_type"/>
                    <field name="signer_id"/>
                    <field name="event_at"/>
                    <group>
                        <filter name="group_request" string="Request" context="{'group_by': 'request_id'}"/>
                        <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                        <filter name="group_signer" string="Signer" context="{'group_by': 'signer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_open_sign_audit_log_form" model="ir.ui.view">
            <field name="name">open.sign.audit.log.view.form</field>
            <field name="model">open.sign.audit.log</field>
            <field name="arch" type="xml">
                <form string="Audit Log" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="request_id"/>
                                <field name="signer_id"/>
                                <field name="event_type"/>
                                <field name="event_sequence"/>
                                <field name="event_at"/>
                            </group>
                            <group>
                                <field name="ip"/>
                                <field name="user_agent"/>
                                <field name="consent_text_hash"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group>
                            <field name="hash_chain"/>
                            <field name="previous_hash"/>
                            <field name="metadata_json"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_sign_audit_log" model="ir.actions.act_window">
            <field name="name">Audit Logs</field>
            <field name="res_model">open.sign.audit.log</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="open_sign.view_open_sign_audit_log_search"/>
        </record>
    </data>
</odoo>
