<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_open_sign_signer_contact_correction_wizard_form" model="ir.ui.view">
            <field name="name">open.sign.signer.contact.correction.wizard.form</field>
            <field name="model">open.sign.signer.contact_correction.wizard</field>
            <field name="arch" type="xml">
                <form string="Resend Signing Invitation">
                    <group>
                        <group>
                            <field name="signer_id" invisible="1"/>
                            <field name="request_id" readonly="1"/>
                            <field name="request_status" readonly="1"/>
                            <field name="current_email" readonly="1"/>
                            <field name="target_email" placeholder="signer@example.com"/>
                            <field name="actionable_now" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason" placeholder="Explain why the invitation is being resent or corrected."/>
                        </group>
                    </group>
                    <footer>
                        <button
                            name="action_apply_contact_correction"
                            string="Send Invitation"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"
                        />
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
