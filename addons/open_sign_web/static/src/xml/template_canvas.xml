<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="open_sign_web.TemplateCanvas">
        <section class="o_open_sign_web_canvas d-flex flex-column gap-2 h-100">
            <header class="o_open_sign_web_canvas_header d-flex align-items-center justify-content-between gap-2">
                <span>Template Canvas</span>
                <div class="d-flex align-items-center gap-2">
                    <label class="o_open_sign_web_template_picker d-flex align-items-center gap-2 mb-0">
                        <span class="text-muted small">Template</span>
                        <select
                            class="form-select form-select-sm"
                            t-att-value="state.templateId || ''"
                            t-on-change="onTemplateChange"
                        >
                            <option value="">Select a template</option>
                            <t t-foreach="templateOptions" t-as="template" t-key="template.id">
                                <option t-att-value="template.id">
                                    <t t-esc="template.name"/>
                                </option>
                            </t>
                        </select>
                    </label>
                    <span class="text-muted small">
                        <t t-esc="state.fields.length"/> field(s)
                    </span>
                    <span class="text-muted small">
                        Page <t t-esc="state.activePage"/> / <t t-esc="totalPageCount"/>
                    </span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Page navigation">
                        <button
                            class="btn btn-outline-secondary"
                            type="button"
                            t-att-disabled="state.activePage &lt;= 1"
                            t-on-click="goToPreviousPage"
                        >
                            Previous
                        </button>
                        <button
                            class="btn btn-outline-secondary"
                            type="button"
                            t-att-disabled="state.activePage &gt;= totalPageCount"
                            t-on-click="goToNextPage"
                        >
                            Next
                        </button>
                    </div>
                    <t t-if="state.isDirty">
                        <span class="text-warning small">
                            Unsaved changes
                        </span>
                    </t>
                    <t t-if="hasInvalidRoleAssignments">
                        <span class="o_open_sign_web_canvas_notice text-warning">
                            <t t-esc="invalidRoleFieldCount"/> field(s) need role reassignment
                        </span>
                    </t>
                    <t t-if="!canAddFields">
                        <span class="o_open_sign_web_canvas_notice text-muted">
                            Configure signer roles on the selected template before adding fields.
                        </span>
                    </t>
                    <button
                        class="btn btn-sm btn-primary"
                        type="button"
                        t-att-disabled="!canAddFields"
                        t-on-click="() => this.addField()"
                    >
                        Add Default Field
                    </button>
                    <button
                        class="btn btn-sm btn-success"
                        type="button"
                        t-att-disabled="!canSaveFields"
                        t-on-click="this.saveTemplateFields"
                    >
                        <t t-if="state.isSaving">Saving...</t>
                        <t t-else="">Save Fields</t>
                    </button>
                </div>
            </header>
            <div class="o_open_sign_web_editor_layout">
                <aside class="o_open_sign_web_palette">
                    <h4 class="o_open_sign_web_panel_title">Field Palette</h4>
                    <div class="o_open_sign_web_palette_list">
                        <t t-foreach="fieldPaletteEntries" t-as="entry" t-key="entry.type">
                            <button
                                class="btn btn-outline-secondary btn-sm o_open_sign_web_palette_button"
                                type="button"
                                t-att-disabled="!canAddFields"
                                t-on-click="() => this.addFieldFromPalette(entry.type)"
                            >
                                <span class="o_open_sign_web_palette_label">
                                    <t t-esc="entry.label"/>
                                </span>
                                <span class="o_open_sign_web_palette_hint text-muted">
                                    <t t-esc="entry.type"/>
                                </span>
                            </button>
                        </t>
                    </div>
                </aside>
                <div class="o_open_sign_web_canvas_body">
                    <div class="o_open_sign_web_canvas_pages">
                        <t t-foreach="canvasPages" t-as="page" t-key="page.number">
                            <div
                                class="o_open_sign_web_canvas_page"
                                t-att-class="{ 'o_is_active_page': state.activePage === page.number }"
                                t-att-style="getPageStyle(page)"
                                t-on-pointerdown="(ev) => this.onCanvasPagePointerDown(page.number, ev)"
                            >
                                <img
                                    t-if="page.imageDataUrl"
                                    class="o_open_sign_web_page_image"
                                    t-att-src="page.imageDataUrl"
                                    t-att-alt="`PDF page ${page.number}`"
                                    draggable="false"
                                />
                                <div class="o_open_sign_web_page_overlay">
                                    <t t-foreach="getFieldsForPage(page.number)" t-as="field" t-key="field.id">
                                        <div
                                            class="o_open_sign_web_field"
                                            t-att-class="getFieldClasses(field)"
                                            t-att-style="getFieldStyle(field)"
                                            t-on-pointerdown="(ev) => this.onFieldPointerDown(field, ev)"
                                        >
                                            <span class="o_open_sign_web_field_label">
                                                <t t-esc="field.label"/>
                                            </span>
                                            <span class="o_open_sign_web_field_geometry">
                                                <t t-esc="describeField(field)"/>
                                            </span>
                                            <span
                                                class="o_open_sign_web_field_resize_handle"
                                                title="Resize"
                                                t-on-pointerdown.stop.prevent="(ev) => this.onResizePointerDown(field, ev)"
                                            />
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <t t-call="open_sign_web.FieldPropertiesPanel"/>
            </div>
        </section>
    </t>
</templates>
