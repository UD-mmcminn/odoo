<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_sign" name="My Sign Documents">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Sign Documents</t>
            </t>
            <div class="alert alert-info" role="alert">
                Portal signing list view is scaffolded. Tokenized signer access is introduced in T31.
            </div>
        </t>
    </template>

    <template id="portal_sign_page" name="Open Sign Portal Document">
        <t t-call="portal.portal_layout">
            <div
                class="o_open_sign_session card border-0 shadow-sm"
                t-att-data-signer-id="signer.id"
                t-att-data-save-url="save_route or ''"
                t-att-data-submit-url="submit_route or ''"
                t-att-data-decline-url="decline_route or ''"
                t-att-data-otp-request-url="otp_request_url or ''"
                t-att-data-otp-verify-url="otp_verify_url or ''"
                t-att-data-request-revision="request_revision"
                t-att-data-access-token="access_token or ''"
                t-att-data-consent-hash="consent_hash"
            >
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h3 class="mb-1">Sign Document</h3>
                            <p class="text-muted mb-0" t-if="preview_mode">
                                Previewing the signer experience without changing signer evidence.
                            </p>
                            <p class="text-muted mb-0" t-elif="waiting_mode">
                                This signer session is waiting for its turn.
                            </p>
                            <p class="text-muted mb-0" t-elif="readonly_mode">
                                This signer session is available for review only.
                            </p>
                            <p class="text-muted mb-0" t-else="">
                                Complete your fields, save progress, then submit when ready.
                            </p>
                        </div>
                    </div>

                    <div class="alert alert-info" t-if="preview_mode">
                        Preview Mode: this page is read-only and does not change signer activity state.
                    </div>
                    <div class="alert alert-info" t-elif="waiting_mode and waiting_message">
                        <t t-esc="waiting_message"/>
                    </div>
                    <div class="alert alert-info" t-elif="readonly_message">
                        <t t-esc="readonly_message"/>
                    </div>
                    <div class="alert alert-success" t-if="request.params.get('submitted')">
                        Your submission was recorded.
                    </div>
                    <div class="alert alert-success" t-if="request.params.get('declined')">
                        Your decline was recorded.
                    </div>
                    <div class="alert alert-success" t-if="request.params.get('otp_requested')">
                        Verification code queued.
                    </div>
                    <div class="alert alert-success" t-if="request.params.get('otp_verified')">
                        Email verification complete. You can now submit.
                    </div>
                    <div class="alert alert-danger" t-if="portal_error_message">
                        <t t-esc="portal_error_message"/>
                    </div>
                    <div class="alert alert-warning" t-if="submit_blocked_reason">
                        <t t-esc="submit_blocked_reason"/>
                    </div>
                    <div class="alert alert-info" t-if="otp_submit_block_reason">
                        <t t-esc="otp_submit_block_reason"/>
                    </div>
                    <div class="alert alert-danger d-none o_open_sign_error"/>
                    <div class="alert alert-success d-none o_open_sign_success"/>

                    <t t-if="not portal_error_message">
                        <div class="row g-4 o_open_sign_workspace">
                            <div class="col-12 col-xl-8">
                                <section class="o_open_sign_surface_panel border rounded p-3 h-100">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                        <div>
                                            <h5 class="mb-1">Document Surface</h5>
                                            <p class="text-muted mb-0">
                                                Fill fields directly on the PDF preview below.
                                            </p>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2 o_open_sign_surface_actions">
                                            <button
                                                t-if="guided_navigation_available"
                                                type="button"
                                                class="btn btn-primary btn-sm o_open_sign_next_field"
                                            >Next field</button>
                                            <a
                                                t-if="document_url"
                                                t-att-href="document_url"
                                                class="btn btn-outline-secondary btn-sm"
                                                target="_blank"
                                            >View PDF</a>
                                        </div>
                                    </div>
                                    <div class="o_open_sign_pdf_surface_wrapper">
                                        <div
                                            class="o_open_sign_pdf_surface"
                                            t-att-data-pdf-render-url="pdf_render_url or ''"
                                        >
                                            <script type="application/json" class="o_open_sign_fields_payload"><t t-out="portal_fields_json"/></script>
                                            <div class="o_open_sign_pdf_surface_state text-muted">
                                                Loading inline PDF preview...
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <div class="col-12 col-xl-4">
                                <aside class="o_open_sign_sidebar d-flex flex-column gap-3">
                                    <section class="border rounded p-3">
                                        <h5 class="mb-3">Session Details</h5>
                                        <dl class="row mb-0 small">
                                            <dt class="col-sm-4">Request</dt>
                                            <dd class="col-sm-8" t-esc="sign_request.name"/>
                                            <dt class="col-sm-4">Signer</dt>
                                            <dd class="col-sm-8" t-esc="signer.email"/>
                                            <dt class="col-sm-4">Signer State</dt>
                                            <dd class="col-sm-8" t-esc="signer.state"/>
                                            <dt class="col-sm-4">Request</dt>
                                            <dd class="col-sm-8">
                                                <span class="o_open_sign_request_status" t-esc="sign_request.status"/>
                                            </dd>
                                        </dl>
                                    </section>

                                    <section class="border rounded p-3">
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                            <h5 class="mb-0">Field Summary</h5>
                                            <span class="text-muted small">
                                                <t t-esc="len(portal_fields)"/> field(s)
                                            </span>
                                        </div>
                                        <t t-if="portal_fields">
                                            <div class="list-group list-group-flush o_open_sign_field_summary">
                                                <t t-foreach="portal_fields" t-as="field">
                                                    <button
                                                        type="button"
                                                        class="list-group-item list-group-item-action px-0 o_open_sign_field_summary_item"
                                                        t-att-data-field-id="field['id']"
                                                        t-att-data-page="field['page']"
                                                        t-att-data-required="'true' if field['required'] else 'false'"
                                                        t-att-data-editable="'true' if field['editable'] else 'false'"
                                                    >
                                                        <div class="d-flex justify-content-between gap-2">
                                                            <strong class="small" t-esc="field['label']"/>
                                                            <span class="text-muted small">Page <t t-esc="field['page']"/></span>
                                                        </div>
                                                        <div class="text-muted small">
                                                            <span t-esc="field['type']"/>
                                                            <span t-if="field['required']"> | required</span>
                                                            <span t-if="field['editable']"> | editable on PDF</span>
                                                            <span t-else=""> | read-only</span>
                                                        </div>
                                                    </button>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="text-muted small">No fields are assigned to this signer.</div>
                                        </t>
                                    </section>

                                    <div class="border rounded p-3" t-if="declined_reason_display">
                                        <h5 class="mb-2">Decline Reason</h5>
                                        <pre class="mb-0 text-wrap" t-esc="declined_reason_display"/>
                                    </div>

                                    <div class="border rounded p-3" t-if="otp_required and not preview_mode and not readonly_mode and not waiting_mode">
                                        <h5 class="mb-2">Email Verification</h5>
                                        <p class="text-muted mb-2">Verify the email code before submitting this signing request.</p>
                                        <p class="mb-3" t-if="otp_email_hint">
                                            <strong>Code destination:</strong>
                                            <span t-esc="otp_email_hint"/>
                                        </p>
                                        <div class="alert alert-success mb-3" t-if="otp_verified">
                                            Email verification complete.
                                        </div>
                                        <t t-else="">
                                            <p class="text-muted mb-3" t-if="otp_has_active_challenge">
                                                A code is active for 10 minutes from request.
                                            </p>
                                            <div class="d-flex flex-column gap-2 flex-md-row align-items-md-end">
                                                <div class="flex-grow-1">
                                                    <label class="form-label" t-attf-for="o_open_sign_otp_code_#{signer.id}">
                                                        Verification code
                                                    </label>
                                                    <input
                                                        t-attf-id="o_open_sign_otp_code_#{signer.id}"
                                                        type="text"
                                                        inputmode="numeric"
                                                        maxlength="6"
                                                        class="form-control o_open_sign_otp_code"
                                                        placeholder="123456"
                                                    />
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button
                                                        t-if="otp_request_url"
                                                        type="button"
                                                        class="btn btn-outline-secondary o_open_sign_otp_request"
                                                    >Send verification code</button>
                                                    <button
                                                        t-if="otp_verify_url"
                                                        type="button"
                                                        class="btn btn-outline-success o_open_sign_otp_verify"
                                                    >Verify code</button>
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="border rounded p-3" t-if="not readonly_mode">
                                        <div class="form-check mb-2">
                                            <input id="open_sign_consent" class="form-check-input o_open_sign_consent" type="checkbox"/>
                                            <label class="form-check-label" for="open_sign_consent">
                                                I consent to electronic signing.
                                            </label>
                                        </div>
                                        <p class="mb-0 text-muted" t-esc="consent_text"/>
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap" t-if="not readonly_mode">
                                        <button type="button" class="btn btn-outline-primary o_open_sign_save">Save Draft</button>
                                        <button type="button" class="btn btn-primary o_open_sign_submit" t-att-disabled="'disabled' if submit_blocked_reason or otp_submit_block_reason else None">Submit</button>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap" t-if="decline_available or (waiting_mode and refresh_url)">
                                        <button
                                            t-if="decline_available"
                                            type="button"
                                            class="btn btn-outline-danger"
                                            data-bs-toggle="modal"
                                            t-attf-data-bs-target="#o_open_sign_decline_modal_#{signer.id}"
                                        >Decline to Sign</button>
                                        <a t-if="waiting_mode and refresh_url" t-att-href="refresh_url" class="btn btn-outline-primary">Refresh status</a>
                                    </div>
                                </aside>
                            </div>
                        </div>
                    </t>
                    <div
                        t-if="decline_available"
                        class="modal fade"
                        t-attf-id="o_open_sign_decline_modal_#{signer.id}"
                        tabindex="-1"
                        aria-hidden="true"
                    >
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Decline This Signing Request</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-3">Tell the sender why you are declining this request.</p>
                                    <label class="form-label" t-attf-for="o_open_sign_decline_reason_#{signer.id}">
                                        Decline reason
                                    </label>
                                    <textarea
                                        t-attf-id="o_open_sign_decline_reason_#{signer.id}"
                                        class="form-control o_open_sign_decline_reason"
                                        rows="4"
                                        required="required"
                                    />
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn btn-danger o_open_sign_decline_confirm">Decline</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
