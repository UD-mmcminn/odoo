<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_open_sign_request_signer_list_portal_link" model="ir.ui.view">
            <field name="name">open.sign.request.signer.view.list.portal.link</field>
            <field name="model">open.sign.request.signer</field>
            <field name="inherit_id" ref="open_sign.view_open_sign_request_signer_list"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sign_access_url']" position="after">
                    <field
                        name="portal_sign_url"
                        string="Copy Link"
                        widget="CopyClipboardURL"
                        readonly="1"
                        optional="show"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_required"
                        optional="show"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_verified_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_issued_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_expires_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_revoked_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                </xpath>
                <xpath expr="//button[@name='action_resend_signer_request']" position="after">
                    <button
                        name="action_revoke_signer_portal_token"
                        type="object"
                        string="Revoke Link"
                        class="btn-link"
                        icon="fa-ban"
                        groups="open_sign.group_open_sign_manager"
                        confirm="This invalidates the current signer link. A new link will require resend."
                    />
                </xpath>
            </field>
        </record>

        <record id="view_open_sign_request_signer_form_portal_link" model="ir.ui.view">
            <field name="name">open.sign.request.signer.view.form.portal.link</field>
            <field name="model">open.sign.request.signer</field>
            <field name="inherit_id" ref="open_sign.view_open_sign_request_signer_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sign_access_url']" position="after">
                    <field
                        name="portal_sign_url"
                        string="Copy Link"
                        widget="CopyClipboardURL"
                        readonly="1"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_required"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_verified_at"
                        readonly="1"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <button
                        name="action_revoke_signer_portal_token"
                        type="object"
                        string="Revoke Link"
                        class="oe_link"
                        groups="open_sign.group_open_sign_manager"
                        invisible="not id"
                        confirm="This invalidates the current signer link. A new link will require resend."
                    />
                    <field
                        name="email_token_issued_at"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_expires_at"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_revoked_at"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                </xpath>
            </field>
        </record>

        <record id="view_open_sign_request_form_portal_link" model="ir.ui.view">
            <field name="name">open.sign.request.view.form.portal.link</field>
            <field name="model">open.sign.request</field>
            <field name="inherit_id" ref="open_sign.view_open_sign_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='signer_ids']/list/field[@name='sign_access_url']" position="after">
                    <field
                        name="portal_sign_url"
                        string="Copy Link"
                        widget="CopyClipboardURL"
                        readonly="1"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_required"
                        optional="show"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="otp_verified_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_user,open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_issued_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_expires_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                    <field
                        name="email_token_revoked_at"
                        optional="hide"
                        readonly="1"
                        groups="open_sign.group_open_sign_manager"
                    />
                </xpath>
                <xpath expr="//field[@name='signer_ids']/list/button[@name='action_resend_signer_request']" position="after">
                    <button
                        name="action_revoke_signer_portal_token"
                        type="object"
                        string="Revoke Link"
                        class="btn-link"
                        icon="fa-ban"
                        groups="open_sign.group_open_sign_manager"
                        invisible="not id"
                        confirm="This invalidates the current signer link. A new link will require resend."
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
